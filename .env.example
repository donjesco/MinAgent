# =============================================================================
# MinAgent Configuration
# =============================================================================
# Copy this file to .env and configure for your environment.
# MinAgent reads .env from the installation directory.
# Environment variables in the OS take precedence over .env.
#
# For llama.cpp local server:
#   OPENAI_BASE_URL=http://127.0.0.1:8080/v1
#   OPENAI_API_KEY=llama.cpp
#   OPENAI_MODEL=llama.cpp
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI-Compatible Server Configuration
# -----------------------------------------------------------------------------
# Base URL for the Chat Completions endpoint (SSE streaming required)
# Default: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# API Key for authentication (optional for some providers)
# Examples: "sk-...", "llama.cpp", "your-api-key"
OPENAI_API_KEY=tu_api_key_aqui

# Model identifier (REQUIRED)
# Must match your server's model names
# Examples: "gpt-4o", "llama.cpp", "claude-3-opus"
OPENAI_MODEL=tu_model

# Input modalities supported
# REQUIRED: "text"
# OPTIONAL: "image" (for multimodal models)
# Examples: "text", "text,image"
OPENAI_INPUT=text

# Context window size in tokens
# Set to your actual model's context limit
# Examples: 4096, 16384, 128000, 262144
# Default: 262144
OPENAI_CONTEXT_WINDOW=128000

# -----------------------------------------------------------------------------
# Permission Modes
# -----------------------------------------------------------------------------
# Three modes: "auto", "ask", or "off"
#
# AUTO:   Execute without asking for approval
# ASK:    Request approval for each action (RECOMMENDED for first use)
# OFF:    Disable the feature and omit tools
#
# TERMINAL_MODE: Approval for terminal commands
# SKILLS_MODE:   Approval for skill usage
# MCP_MODE:      Approval for MCP tool calls
# -----------------------------------------------------------------------------

# Terminal command mode
# auto: Execute commands automatically
# ask:  Request approval for each command (RECOMMENDED)
# off:  Disable terminal commands
TERMINAL_MODE=ask

# Skills mode
# auto: Load skills automatically
# ask:  Request approval before loading each skill
# off:  Disable skills
SKILLS_MODE=ask

# MCP mode
# auto: Connect to MCP servers automatically
# ask:  Request approval before using each MCP tool
# off:  Disable MCP tools
MCP_MODE=ask

# Maximum MCP tools exposed to the model
# Default: 50
# Adjust based on your needs and context window
MCP_MAX_TOOLS=50

# -----------------------------------------------------------------------------
# Additional Settings
# -----------------------------------------------------------------------------
# Disable terminal colors (optional)
# Set to any value to disable
# NO_COLOR=

# Reasoning format for llama.cpp (optional)
# Use "deepseek" if model doesn't emit reasoning_content automatically
# REASONING_FORMAT=deepseek
